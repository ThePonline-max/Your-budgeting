{
  "appId": "com.thep.budgeting",
  "appName": "Your Budgeting",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
    
  },
  "ios": {
    "scrollEnabled": false,
    "contentInset": "never",
    "allowsLinkPreview": false
  },
  "server": {
    "iosScheme": "capacitor"
  }

  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#6C5CE7",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#6C5CE7"
    },
    "Keyboard": {
      "resize": "none",
      "style": "DARK",
      "resizeOnFullScreen": true
    }
  }
}

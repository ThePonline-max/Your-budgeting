{
  "appId": "com.thep.budgeting",
  "appName": "Your Budgeting",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "ios": {
    "scrollEnabled": false,
    "contentInset": "never",
    "allowsLinkPreview": false,
    "backgroundColor": "#6C5CE7"
  },
  "android": {
    "backgroundColor": "#6C5CE7",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#6C5CE7",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#6C5CE7",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "none",
      "style": "DARK",
      "resizeOnFullScreen": true
    }
  }
}

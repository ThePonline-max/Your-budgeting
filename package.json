{
  "name": "your-budget",
  "version": "1.0.0",
  "description": "Your personal budget & expense tracker",
  "main": "index.js",
  "scripts": {
    "build": "echo \"Static app - no build step needed\"",
    "cap:init": "npx cap init \"Your Budgeting\" com.thep.budgeting --web-dir www",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "android:build": "cd android && ./gradlew assembleRelease",
    "ios:build": "cd ios && xcodebuild -workspace App/App.xcworkspace -scheme App -configuration Release"
  },
  "dependencies": {
    "@capacitor/core": "5.7.8",
    "@capgo/native-purchases": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "5.7.8",
    "@capacitor/android": "5.7.8",
    "@capacitor/ios": "5.7.8"
  },
  "author": "Peter",
  "license": "MIT",
  "engines": {
    "node": ">=18 <21"
  }
}
